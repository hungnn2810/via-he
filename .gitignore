# ===== Shared =====

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editors and IDEs (Rider, Visual Studio, VS Code)
.idea/
.vs/
.vscode/
*.user
*.userprefs
*.suo
*.DotSettings.user
*.swp
*~

# Logs and temp files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp

# Secrets: keep only the examples
.env
.env.*
!.env.example

# Node packages (root tools and server)
node_modules/

# ===== Server (Node.js + Colyseus) =====

# Runtime data: the database, the token secret and anything else the server writes.
# Hand-written JSON data (dialogues, events) is tracked.
server/data/*
!server/data/*.json

server/dist/
server/build/
server/coverage/
*.tsbuildinfo

